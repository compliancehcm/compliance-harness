# Environment for deploy/docker/compose.yml. Copy to compliance-ai.env beside
# this file; that name is ignored by Git and by the Docker build context, so the
# filled-in copy can never be committed or baked into an image.
#
# Only the deployment-specific values are listed. Every other knob, with its
# default, is in deploy/docker/README.md under "Environment".

# ── identity provider (required) ─────────────────────────────────────────────
SSO_ISSUER=https://sso.compliancehcm.com.br/realms/ComplianceHCM
SSO_CLIENT_ID=compliance-ai-harness
# The origin browsers use. SSO_PUBLIC_URL/auth/callback must be registered as a
# redirect URI on the client, exactly.
SSO_PUBLIC_URL=
# Leave empty for a public PKCE client.
SSO_CLIENT_SECRET=

# ── model providers ──────────────────────────────────────────────────────────
# The composed default LLM is OpenRouter; this one is required in practice.
OPENROUTER_API_KEY=
# Still read by the shipped web_search tool.
DEEPSEEK_API_KEY=
